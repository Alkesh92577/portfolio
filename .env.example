# Render service settings (copy these into Render -> Environment)
NODE_ENV=production
PORT=10000

# TiDB Cloud MySQL-compatible connection details
DB_HOST=YOUR_TIDB_HOST
DB_PORT=4000
DB_USER=YOUR_TIDB_USERNAME
DB_PASSWORD=YOUR_TIDB_PASSWORD
DB_NAME=portfolio

# Admin account created on first server startup
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=choose_a_strong_password_at_least_12_chars

# Generate a long random secret (32+ characters)
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long

# Exact Vercel production domain(s), comma-separated if multiple
FRONTEND_URL=https://YOUR-PORTFOLIO.vercel.app

# Cloudinary -> Dashboard -> Product Environment Credentials
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
MAX_UPLOAD_MB=8
